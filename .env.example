# Copy this to .env.local for local ServiceNow testing.
# .env.local is ignored by git and may contain real credentials.

SERVICENOW_INSTANCE_URL=https://devXXXXX.service-now.com
SERVICENOW_MODE=instance
SERVICENOW_API=jsonv2

# Basic auth smoke and Collector example config.
SERVICENOW_USERNAME=otel_em_exporter
SERVICENOW_PASSWORD=

# Optional static bearer token auth.
SERVICENOW_BEARER_TOKEN=

# Optional OAuth2 client credentials auth.
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_TOKEN_URL=https://devXXXXX.service-now.com/oauth_token.do

# Optional MID Web Server API key auth.
SERVICENOW_MID_URL=https://mid-host.example.net:8443
SERVICENOW_MID_API_KEY=

# Optional metrics-derived event example run identifier.
SERVICENOW_METRICS_EVENT_RUN_ID=local-validation

# Keep unset or 0 for dry runs. Set to 1 only when intentionally posting a smoke event.
SERVICENOW_SEND=0
